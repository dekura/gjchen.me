---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const wordCount = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 220));
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="essay-shell">
    <header class="essay-header">
      <a class="essay-back" href="/writing/">← Writing</a>
      <p class="essay-kicker">Essay</p>
      <h1 class="essay-title">
        {post.data.title}
      </h1>
      <p class="essay-description">{post.data.description}</p>
      <div class="essay-meta">
        <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString("en", { month: "long", day: "numeric", year: "numeric" })}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} min read</span>
        {post.data.tags.length > 0 && <span aria-hidden="true">·</span>}
        {post.data.tags.length > 0 && <span>{post.data.tags.join(" · ")}</span>}
      </div>
    </header>

    {tocHeadings.length > 0 && (
      <aside class="essay-toc" aria-label="Table of contents">
        <p class="essay-toc-title">On this page</p>
        <nav>
          {tocHeadings.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
        </nav>
      </aside>
    )}

    <div class="essay-prose">
      <Content />
    </div>
  </article>
</BaseLayout>

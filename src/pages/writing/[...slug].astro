---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="shell article-layout">
    <div>
      <p class="content-meta">
        {post.data.date.toISOString().slice(0, 10)} · {post.data.tags.join(" · ")}
      </p>
      <h1 class="article-title">
        {post.data.title}
      </h1>
      <p class="page-copy">{post.data.description}</p>
      <div class="prose">
        <Content />
      </div>
    </div>
    <aside class="toc">
      <p class="toc-title">On this page</p>
      <nav>
        {headings.filter((heading) => heading.depth <= 3).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
      </nav>
    </aside>
  </article>
</BaseLayout>

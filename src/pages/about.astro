---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="About" description="About Guojin Chen.">
  <section class="shell page-hero">
    <p class="eyebrow">About</p>
    <h1 class="page-title">
      A research homepage with room for a fuller personal surface.
    </h1>
    <p class="page-copy">
      I am a senior researcher at Huawei Hong Kong Research Center. I received
      my Ph.D. in Computer Science from the Chinese University of Hong Kong.
      My current work focuses on post-training, evaluation, and data
      infrastructure for foundation models for agentic systems. During my Ph.D.,
      I worked on computational lithography, design for manufacturing, and
      optimization.
    </p>
  </section>

  <section class="shell section card-grid">
    <div class="card">
      <h2 class="section-title">Experience</h2>
      <div class="stack">
        <div>
          <p class="content-title">Huawei Hong Kong Research Center</p>
          <p class="muted">Senior Researcher · 2025 -- Present</p>
        </div>
        <div>
          <p class="content-title">Google DeepMind</p>
          <p class="muted">Ph.D. Student Researcher · 2024</p>
        </div>
        <div>
          <p class="content-title">NVIDIA Research</p>
          <p class="muted">Research Scientist Intern · 2024</p>
        </div>
      </div>
    </div>
    <div class="card">
      <h2 class="section-title">Education</h2>
      <div class="stack">
        <div>
          <p class="content-title">Chinese University of Hong Kong</p>
          <p class="muted">Ph.D. in Computer Science · 2021 -- 2025</p>
        </div>
        <div>
          <p class="content-title">Chinese University of Hong Kong</p>
          <p class="muted">M.S. in Computer Science · 2019 -- 2020</p>
        </div>
        <div>
          <p class="content-title">Huazhong University of Science and Technology</p>
          <p class="muted">B.S. in Computer Science · 2015 -- 2019</p>
        </div>
      </div>
      <a class="text-link" href="/research/data/cv.pdf">Download full CV</a>
    </div>
  </section>
</BaseLayout>
